# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- litellm proxy auth ---
# Master key clients present as the OpenAI api_key (Bearer). Generate a random one.
LITELLM_MASTER_KEY=sk-REPLACE-ME

# --- agy gateway (primary backend, handlers/agy_handler.py) ---
AGY_BASE=http://192.168.0.92:8100
AGY_TOKEN=REPLACE-ME

# --- cloud fallback (optional) ---
# Leave unset to run without a cloud fallback; the `cloud` model stays unused.
ANTHROPIC_API_KEY=

# --- on-demand ollama controller (handlers/routing_hook.py) ---
CONTROLLER_URL=http://192.168.0.34:8765
CONTROLLER_TOKEN=REPLACE-ME

# --- OpenTelemetry export (litellm "otel" callback -> lab Alloy OTLP ingest) ---
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# cli-gateways (LXC 108/109)
OPENCODE_BASE=http://192.168.0.93:8100
OPENCODE_TOKEN=changeme
CLAUDECODE_BASE=http://192.168.0.94:8100
CLAUDECODE_TOKEN=changeme
